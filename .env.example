# Copy to .env for local use. Do not put real secrets in this file.
# .env is gitignored. GitHub Actions secrets are set in the repo settings,
# not here.

# Optional. News search works from RSS without this. Used only when the
# newsapi source is enabled in config.
NEWS_API_KEY=

# Optional. Used only when ENABLE_SUMMARY is true. Never required to search.
# Summaries are cached by article URL. A missing key, timeout, or API error
# leaves the headlines in place.
ANTHROPIC_API_KEY=
ENABLE_SUMMARY=false
SUMMARY_MODEL=claude-3-5-haiku-latest

# Flask
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Path to the customer YAML. Default is config.yaml in the project root.
CONFIG_PATH=config.yaml

# SQLite search history. Docker should point this at a volume, for example
# /data/search_history.db. search_history.json is only read once to migrate.
HISTORY_DB=search_history.db
HISTORY_FILE=search_history.json

# Result reminder scripts (scripts/send_reminders.py). Not read by the Flask app.
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_EMAIL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# REMINDER_DAYS=10,5
